APP_NAME="AES Project Tracker"

# Production URL (optional — auto-detected from the request if omitted)
# BASE_URL="https://track.aessas.in"
# APP_BASE_PATH=""

# Database (required on cPanel)
# DB_HOST="localhost"
# DB_USER=""
# DB_PASS=""
# DB_NAME=""

# Set true only while debugging deployment; leave false in production
APP_DEBUG=false

MAIL_ENABLED=true
# Driver: smtp | elastic
MAIL_DRIVER=smtp

# SMTP (used when MAIL_DRIVER=smtp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH=true

# Shared from identity
MAIL_FROM=
MAIL_FROM_NAME="AES Project Tracker"

# Elastic Email (used when MAIL_DRIVER=elastic)
# ELASTIC_EMAIL_API_KEY=
# ELASTIC_EMAIL_ENDPOINT=https://api.elasticemail.com/v2/email/send
